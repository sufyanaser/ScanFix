{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sufyanaser/ScanFix/datasets/golden/manifest.schema.json",
  "title": "ScanFix Golden Dataset Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "source", "taxonomy", "expected", "review"],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^GD-[0-9]{3,}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "mime_type", "width_px", "height_px", "provenance", "sensitive"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "mime_type": {"type": "string", "enum": ["image/jpeg", "image/png", "image/heic", "image/tiff"]},
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "provenance": {
          "type": "string",
          "enum": ["phone-camera", "whatsapp-photo", "whatsapp-document", "scanner", "synthetic", "public-domain", "other"]
        },
        "sensitive": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "taxonomy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "clean",
          "mild-perspective",
          "severe-perspective",
          "rotation",
          "deskew",
          "curved-page",
          "folded-page",
          "partial-page",
          "occluded-edge",
          "hand-visible",
          "weak-boundary",
          "white-on-white",
          "busy-background",
          "strong-shadow",
          "uneven-lighting",
          "underexposed",
          "overexposed",
          "motion-blur",
          "focus-blur",
          "jpeg-compression",
          "low-resolution",
          "colored-stamp",
          "faint-stamp",
          "signature",
          "handwriting",
          "table",
          "thin-lines",
          "carbon-copy",
          "mixed-arabic-latin",
          "eastern-arabic-digits"
        ]
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_corners_px": {
          "type": ["array", "null"],
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "number"}
          }
        },
        "orientation_deg": {
          "type": ["integer", "null"],
          "enum": [0, 90, 180, 270, null]
        },
        "deskew_deg": {"type": ["number", "null"]},
        "reference_notes": {"type": "string"}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto_process_allowed", "manual_review_allowed", "content_reconstruction_allowed"],
      "properties": {
        "auto_process_allowed": {"type": "boolean"},
        "manual_review_allowed": {"type": "boolean"},
        "content_reconstruction_allowed": {"const": false},
        "must_preserve_color": {"type": "boolean"},
        "must_preserve_stamp": {"type": "boolean"},
        "must_preserve_signature": {"type": "boolean"},
        "expected_failure_mode": {
          "type": ["string", "null"],
          "enum": ["manual-corners", "manual-rotation", "manual-review", "unsupported-source", "quality-warning", null]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["unreviewed", "approved", "rejected"]},
        "reviewer": {"type": "string"},
        "review_notes": {"type": "string"}
      }
    }
  }
}